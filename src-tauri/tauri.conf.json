{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZERO TRACE",
  "version": "0.1.0",
  "identifier": "com.forenx.secure-eraser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZERO TRACE",
        "width": 900,
        "height": 650,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}